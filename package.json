{
  "name": "mamep2026",
  "private": true,
  "version": "0.0.17",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "pnpm --filter @mamep2026/web dev",
    "dev:electron": "pnpm --filter @mamep2026/web dev:electron",
    "dev:vscode": "node scripts/dev-vscode.mjs",
    "dev:slave": "node scripts/dev-with-slave.mjs dev",
    "dev:electron:slave": "node scripts/dev-with-slave.mjs dev:electron",
    "dev:vscode:slave": "node scripts/dev-with-slave.mjs dev:vscode",
    "build": "pnpm --filter @mamep2026/web build",
    "build:electron": "pnpm --filter @mamep2026/web build:electron",
    "start:electron": "electron .",
    "dist:portable": "pnpm build:electron && node scripts/package-electron.mjs && electron-builder",
    "dist:vscode": "pnpm build:vscode && node scripts/package-vscode.mjs",
    "slave": "node scripts/modbus-slave/modbus-rtu-slave.mjs",
    "build:vscode": "node scripts/build-vscode.mjs",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:acceptance": "pnpm --filter @mamep2026/acceptance test",
    "test:e2e:web": "pnpm --filter @mamep2026/e2e-web test",
    "test:e2e:electron": "pnpm --filter @mamep2026/e2e-electron test",
    "test:e2e:vscode": "pnpm build:vscode && pnpm --filter @mamep2026/e2e-vscode test",
    "test:serial:virtual": "node scripts/serial-virtual-test.mjs",
    "prototype:electron": "electron scripts/prototype/electron-serial-probe.mjs",
    "probe:vscode:serial": "node tests/e2e-vscode/scripts/run-probe-serial.mjs",
    "preview": "pnpm --filter @mamep2026/web preview",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@hookform/resolvers": "^5.7.1",
    "antd": "^6.6.0",
    "i18next": "^26.3.6",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.11",
    "serialport": "^13.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.125.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "^4.1.10"
  }
}
